# =============================================================================
# Gods of the Arena / WarOfGods — Unreal Engine 5 .gitignore
# Based on Epic/GitHub UnrealEngine.gitignore with project-specific additions
# =============================================================================

# -----------------------------------------------------------------------------
# Unreal Engine generated
# -----------------------------------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
**/Build/Receipts/

# Local File Open Order (machine-specific)
**/FileOpenOrder/**

# Built map data (regenerated by editor/cook)
*_BuiltData.uasset

# -----------------------------------------------------------------------------
# IDE / tooling
# -----------------------------------------------------------------------------
.vs/
.idea/
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.xcworkspace
*.xcodeproj
.vscode/
*.code-workspace

# Rider / CLion extras
*.DotSettings.user
cmake-build-*/

# -----------------------------------------------------------------------------
# Compiled / object artifacts (safety net if generated outside Binaries/)
# -----------------------------------------------------------------------------
*.obj
*.o
*.lo
*.slo
*.pch
*.gch
*.pdb
*.ipdb
*.iobj
*.exp
*.lib
*.a
*.dll
*.so
*.dylib
*.exe
*.app
*.ipa
*.xdelta
*.cache

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Python / tooling caches (automation, Gauntlet helpers)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# -----------------------------------------------------------------------------
# Packaging / deployment leftovers
# -----------------------------------------------------------------------------
*.log
*.apk
*.aab
*.obb
Releases/
Packaged/
Staging/

# Keep intentional Build icon / pak blacklist exceptions if added later
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Local recovery snapshots / scratch (never commit)
**/_phase0_recovery/
**/_recovery/

# Autosave duplicates sometimes land outside Saved/ when misconfigured
**/Autosaves/

# Legacy course leftovers
MultiplayerCourse/.vs/
MultiplayerCourse/Intermediate/

# -----------------------------------------------------------------------------
# Heavy marketplace libraries — keep on disk for arena dressing; curate before commit
# See Docs/GOTA_ASSET_CLEANUP.md
# -----------------------------------------------------------------------------
WarOfGods/Content/Megascans/
WarOfGods/Content/EuropeanBeech/
WarOfGods/Content/Maps/Assembly/
WarOfGods/Content/Maps/Assembly_Zoo.*
WarOfGods/Content/Maps/Megascans_Zoo.*
WarOfGods/Content/FightingAnimsetPro/SourceFiles/

